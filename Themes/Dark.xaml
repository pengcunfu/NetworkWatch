<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Mocha (深色) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#11111b"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#181825"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#313244"/>
    <SolidColorBrush x:Key="TextBrush" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#a6adc8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="DownloadBrush" Color="#a6e3a1"/>
    <SolidColorBrush x:Key="UploadBrush" Color="#f9e2af"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#313244"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#11111b"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#bac2de"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#313244"/>
</ResourceDictionary>
