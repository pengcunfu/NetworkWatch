<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Latte (浅色) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#eff1f5"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#e6e9ef"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#ccd0da"/>
    <SolidColorBrush x:Key="TextBrush" Color="#4c4f69"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6c6f85"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1e66f5"/>
    <SolidColorBrush x:Key="DownloadBrush" Color="#40a02b"/>
    <SolidColorBrush x:Key="UploadBrush" Color="#df8e1d"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#e6e9ef"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#bcc0cc"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#dce0e8"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#e6e9ef"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#5c5f77"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#ccd0da"/>
</ResourceDictionary>
