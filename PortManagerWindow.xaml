<Window x:Class="NetworkWatch.PortManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口管理"
        Height="640" Width="1000"
        WindowStartupLocation="CenterOwner"
        MinHeight="420" MinWidth="720"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Margin="0,0,12,0"
                     TextChanged="FilterBox_TextChanged"/>
            <CheckBox x:Name="AutoRefreshCheckBox"
                      Grid.Column="1"
                      Content="自动刷新"
                      Margin="0,0,12,0"
                      Checked="AutoRefreshCheckBox_Changed"
                      Unchecked="AutoRefreshCheckBox_Changed"/>
            <Button Grid.Column="2" Content="刷新" Click="RefreshButton_Click"/>
        </Grid>

        <!-- Connection list -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <DataGrid x:Name="ConnectionGrid"
                      ItemsSource="{Binding}"
                      SelectionMode="Extended"
                      MouseDoubleClick="ConnectionGrid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="ConnectionGrid_PreviewMouseRightButtonDown"
                      ContextMenuOpening="ConnectionGrid_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="查看详情" Click="ViewDetailMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="终止进程" Click="KillMenuItem_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                    <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="*"/>
                    <DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort}" Width="80"/>
                    <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteAddress}" Width="*"/>
                    <DataGridTextColumn Header="远程端口" Binding="{Binding RemotePort}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="就绪"/>
                <TextBlock x:Name="ElevationText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
